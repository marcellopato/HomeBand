{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeBand",
  "version": "1.0.0",
  "identifier": "com.marcellopato.homeband",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HomeBand",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "AudioVideo",
    "shortDescription": "HomeBand Linux & Web Audio Workstation",
    "longDescription": "Modern cross-platform DAW reverse-engineered with Web Audio API, AudioWorklet DSP, and Vue 3."
  }
}
