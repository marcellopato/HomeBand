{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "HomeBand",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$APP/*", "$DESKTOP/*", "$DOCUMENT/*", "$DOWNLOAD/*"]
      },
      "dialog": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["deb", "appimage"],
      "identifier": "com.marcellopato.homeband",
      "icon": [
        "icons/icon.png"
      ],
      "category": "AudioVideo",
      "shortDescription": "HomeBand Linux & Web Audio Workstation",
      "longDescription": "Modern cross-platform DAW reverse-engineered with Web Audio API, AudioWorklet DSP, and Vue 3."
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "HomeBand",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
